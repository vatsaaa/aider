# Example environment variables for the Digital Equity Analyst

# Anthropic
# API key for Anthropic Claude (get from console.anthropic.com)
ANTHROPIC_API_KEY=

# Ollama (local LLM host and model)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Redis (Redis Streams event bus)
REDIS_URL=redis://localhost:6379

# PostgreSQL (SQLAlchemy / psycopg connection string)
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/analyst_db

# FRED API key (register at https://fred.stlouisfed.org)
FRED_API_KEY=

# SEC EDGAR user-agent string (required by EDGAR ToS: "First Last email@domain.com")
SEC_USER_AGENT=

# Git audit repo path and author info
GIT_REPO_PATH=./reports_audit
GIT_AUTHOR_NAME=Digital Analyst
GIT_AUTHOR_EMAIL=analyst@localhost

# SMTP for publishing reports
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=analyst@localhost
SMTP_TO=analyst@localhost  # comma-separated list of recipients

# Pipeline behaviour
DLQ_STREAM=dlq:failed
MAX_REVISION_ITERATIONS=3
DAILY_CLAUDE_SPEND_LIMIT_USD=10.00
CONFIDENCE_THRESHOLD=0.75

# Environment
ENV=development
